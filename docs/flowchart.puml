@startuml システム全体概要
title Chibi-T Furoshiki Logger - システム全体フロー

start

:M5Stack Core2 起動;

partition "初期化フェーズ (setup)" {
    :M5.begin()
    各種シリアル初期化
    - Serial (デバッグ)
    - Serial1 (ECU)
    - Serial2 (GNSS)
    - SerialBLE (温度センサ);
    
    :LCD初期化
    スプライト作成;
    
    :SDカード初期化
    (最大3秒待機);
    
    if (SD初期化成功?) then (yes)
        :LOGGING = true
        /LOG ディレクトリ確認/作成
        ログファイル作成;
    else (no)
        :LOGGING = false;
    endif
    
    :WiFi設定フロー
    (5秒間ボタン待機);
    
    note right
        Aボタン: 手動設定
        Cボタン: WiFi無効
        無操作: 自動接続
    end note
    
    if (WiFi有効?) then (yes)
        if (接続成功?) then (yes)
            :isWifiConfigSucceeded = true;
            
            if (Ambient有効?) then (yes)
                :チャネル情報取得
                Ambient初期化;
            endif
            
            if (MQTT有効?) then (yes)
                :証明書設定
                MQTTサーバー設定;
            endif
        else (no)
            :WiFi機能無効化;
        endif
    else (no)
        :ambientpush = false
        MQTTpush = false;
    endif
    
    :タイマー初期化
    t_Serial, t_SD, t_MQTT, t_amb;
}

partition "メインループ (loop)" {
    repeat
        :M5.update();
        
        :データ収集;
        note right
            updateBLE()
            updateECU()
            updateGNSS()
        end note
        
        :updateDisplay()
        表示モード切替
        画面描画;
        
        if (t_Serial間隔経過?) then (yes)
            :updateSerialOutput()
            CSV形式でシリアル出力;
        endif
        
        if (LOGGING && t_SD間隔経過?) then (yes)
            :updateSDLog()
            SDカードへ記録;
        endif
        
        if (MQTTpush?) then (yes)
            if (走行前?) then (yes)
                if (t_MQTT >= 10秒?) then (yes)
                    :updateMQTT()
                    JSON送信;
                endif
            else (走行中)
                if (t_MQTT >= 1秒?) then (yes)
                    :updateMQTT()
                    JSON送信;
                endif
            endif
        endif
        
        if (ambientpush && t_amb間隔経過?) then (yes)
            :updateAmbient()
            データ送信;
        endif
        
        :delay(10);
        
    repeat while (システム稼働中)
}

stop

@enduml

@startuml setup詳細フロー
title setup() - 初期化処理詳細

start

partition "ハードウェア初期化" {
    :M5.begin(cfg)
    M5.update();
    
    :Serial.begin(115200)
    デバッグ用;
    
    :Serial1.begin(115200, SERIAL_8N1, 27, 19)
    ECU接続;
    
    :Serial2.begin(115200)
    GNSS接続;
    
    if (USE_HARDWARE_BLE?) then (1)
        :SerialBLE.begin(115200, SERIAL_8N1, 32, 33)
        UART2使用;
    else (0)
        :SerialBLE.begin(115200)
        SoftwareSerial使用;
    endif
}

partition "LCD初期化" {
    :lcd.init()
    lcd.setRotation(1)
    lcd.setBrightness(128)
    lcd.fillScreen(TFT_BLACK);
    
    :lcd_s.setColorDepth(8)
    lcd_s.createSprite(width, height)
    スプライト作成;
    
    :フォント・テキスト設定;
}

partition "SDカード初期化" {
    :sdStart = millis();
    :sdInitialized = false;
    
    repeat
        if (sd.begin(SD_CONFIG)?) then (yes)
            :sdInitialized = true;
            break;
        endif
        
        :M5.update();
        
        :画面に警告表示
        "MicroSDが見つかりません"
        残り時間カウントダウン;
        
        :delay(1000);
        
    repeat while (millis() - sdStart < 3000)
    
    if (sdInitialized?) then (yes)
        if (/LOG ディレクトリ存在?) then (no)
            :sd.mkdir("/LOG")
            画面メッセージ表示;
        endif
        
        repeat
            :fileName生成
            /LOG/LOG%04d.CSV;
            
        repeat while (ファイル既存?) is (yes)
        ->no;
        
        :logFile.open()
        BOM書き込み (UTF-8)
        CSVヘッダ書き込み;
        
        :logFile.close();
        
    else (no)
        :LOGGING = false
        エラーログ出力;
    endif
}

partition "WiFi設定" {
    :APコールバック設定
    (QRコード表示);
    
    :画面表示
    "Aボタン: WiFi設定"
    "Cボタン: WiFi無効化";
    
    :doManualConfig = false
    btnStart = millis();
    
    repeat
        :M5.update();
        
        if (BtnA.isPressed?) then (yes)
            :doManualConfig = true;
            break;
        endif
        
        if (BtnC.isPressed?) then (yes)
            :ambientpush = false
            MQTTpush = false;
            break;
        endif
        
        :delay(10);
        
    repeat while (millis() - btnStart < 5000)
    
    if (doManualConfig?) then (yes)
        :wifiManager.startConfigPortal();
        
        if (成功?) then (yes)
            :isWifiConfigSucceeded = true;
        else (no)
            :isWifiConfigSucceeded = false;
        endif
        
    else (no)
        if (ambientpush || MQTTpush?) then (yes)
            :画面表示
            "Wi-Fi接続中...";
            
            :wifiManager.autoConnect();
            
            if (成功?) then (yes)
                :isWifiConfigSucceeded = true;
            else (no)
                :isWifiConfigSucceeded = false
                ambientpush = false
                MQTTpush = false;
            endif
        else (no)
            :画面表示
            "Wi-Fi無効";
        endif
    endif
}

partition "Ambient設定" {
    if (ambientpush && isWifiConfigSucceeded?) then (yes)
        :MACアドレス取得
        devKey生成;
        
        :ambient.getchannel()
        チャネルID・writeKey取得;
        
        repeat
            :M5.update();
            :delay(500);
        repeat while (チャネル取得失敗?) is (yes)
        ->no;
        
        :ambient.begin()
        初期化完了;
    endif
}

partition "MQTT設定" {
    if (MQTTpush && isWifiConfigSucceeded?) then (yes)
        :mqttclient.setBufferSize(512);
        
        :client.setCACert(AWS_CERT_CA)
        client.setCertificate(AWS_CERT_CRT)
        client.setPrivateKey(AWS_CERT_PRIVATE)
        証明書設定;
        
        :mqttclient.setServer(mqtt_server, mqtt_port)
        サーバー接続先設定;
        
        :updateMQTT()
        初回接続試行;
    endif
}

partition "最終準備" {
    :画面表示
    "読み込み中...";
    
    :デバッグ用ヘッダ出力
    Serial.println();
    
    :タイマー初期化
    t_Serial = millis()
    t_SD = millis()
    t_MQTT = millis()
    t_amb = millis();
}

stop

